+if(APPLE)
+  # ORT's CPU library does not use Abseil's CoreFoundation local-timezone lookup.
+  get_target_property(absl_time_zone_target absl::time_zone ALIASED_TARGET)
+  get_target_property(absl_time_zone_deps ${absl_time_zone_target} INTERFACE_LINK_LIBRARIES)
+  list(FILTER absl_time_zone_deps EXCLUDE REGEX "CoreFoundation")
+  set_property(TARGET ${absl_time_zone_target} PROPERTY INTERFACE_LINK_LIBRARIES "${absl_time_zone_deps}")
+endif()
